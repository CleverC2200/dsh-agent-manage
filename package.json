{
  "name": "dsh-agent-manage",
  "description": "The standard way to install Claude Code / Codex / Cursor / Kimi plugin marketplace suites in DeepSeek Harness (DSH) — zero conversion, zero file copying. Skills, MCP servers, hooks and slash commands are injected into your dsh sessions at runtime.",
  "version": "0.6.3-company.6",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./business-resources": {
      "types": "./lib/types/runtime/business-resources.d.ts",
      "default": "./lib/runtime/business-resources.js"
    },
    "./forecast-source": {
      "types": "./lib/types/runtime/forecast-source.d.ts",
      "default": "./lib/runtime/forecast-source.js"
    },
    "./inventory-compute/*": {
      "source": "./src/inventory-compute/*.ts",
      "types": "./lib/types/inventory-compute/*.d.ts",
      "default": "./lib/inventory-compute/*.js"
    },
    "./aps-compute/*": {
      "source": "./src/aps-compute/*.ts",
      "types": "./lib/types/aps-compute/*.d.ts",
      "default": "./lib/aps-compute/*.js"
    }
  },
  "files": [
    "lib",
    "client",
    "schemas",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "business-resources",
    "src/inventory-compute",
    "src/aps-compute"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && pnpm run build:client",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "test": "vitest run",
    "test:contract": "vitest run tests/market-contracts.test.ts tests/routes.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "depcruise --validate .dependency-cruiser.cjs src",
    "check:refactor": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:contract && pnpm run check:architecture",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "check:knowledge": "node scripts/check-agent-knowledge.mjs",
    "test:knowledge": "node --test tests/agent-knowledge.test.mjs",
    "sdk:verify": "node scripts/prepare-official-sdk.mjs",
    "sdk:prepare": "node scripts/prepare-official-sdk.mjs --prepare",
    "quality:ci": "node scripts/run-quality-ci.mjs",
    "test:ci-inputs": "node --test tests/sdk-input-cli.test.mjs tests/quality-ci-cli.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CleverC2200/dsh-agent-manage.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "dsh-marketplace",
    "dsh-plugin-marketplace",
    "deepseek-plugin",
    "deepseek-plugins",
    "agent-plugins",
    "agent-plugin",
    "plugin-marketplace",
    "marketplace",
    "claude-code",
    "claude-code-plugins",
    "claude-code-plugin-marketplace",
    "claude",
    "codex",
    "cursor",
    "skills",
    "mcp",
    "mcp-servers",
    "hooks",
    "suite",
    "ai-agents"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-hooks-claude-code": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.17.1",
    "fflate": "^0.8.3",
    "smol-toml": "^1.8.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../official-latest-standard/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../official-latest-standard/packages/client/ui-primitives",
    "@deepseek-ai/dsh-hooks-claude-code": "link:../../official-latest-standard/packages/hooks/hooks-claude-code",
    "@deepseek-ai/dsh-llm": "link:../../official-latest-standard/packages/llm/llm",
    "@deepseek-ai/dsh-mcp-client": "link:../../official-latest-standard/packages/mcp/mcp-client",
    "@deepseek-ai/dsh-skill": "link:../../official-latest-standard/packages/skill/skill",
    "@deepseek-ai/dsh-tools": "link:../../official-latest-standard/packages/core/tools",
    "@eslint/js": "^9.39.5",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "@deepseek-ai/schemastery": "link:../../official-latest-standard/vendor/schemastery"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/CleverC2200/dsh-agent-manage",
  "bugs": {
    "url": "https://github.com/CleverC2200/dsh-agent-manage/issues"
  }
}
