{
  "name": "dsh-agent-manage",
  "description": "配置个人智能体、技能和 MCP 连接，管理原生预设与资源。",
  "version": "0.6.3-company.22",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./business-resources": {
      "types": "./lib/types/runtime/business-resources.d.ts",
      "default": "./lib/runtime/business-resources.js"
    },
    "./forecast-source": {
      "types": "./lib/types/runtime/forecast-source.d.ts",
      "default": "./lib/runtime/forecast-source.js"
    },
    "./inventory-compute/*": {
      "source": "./src/inventory-compute/*.ts",
      "types": "./lib/types/inventory-compute/*.d.ts",
      "default": "./lib/inventory-compute/*.js"
    },
    "./aps-compute/*": {
      "source": "./src/aps-compute/*.ts",
      "types": "./lib/types/aps-compute/*.d.ts",
      "default": "./lib/aps-compute/*.js"
    },
    "./user-agent-cube": {
      "types": "./lib/types/runtime/user-agent-cube.d.ts",
      "default": "./lib/runtime/user-agent-cube.js"
    },
    "./user-agent-skills": {
      "types": "./lib/types/runtime/user-agent-skills.d.ts",
      "default": "./lib/runtime/user-agent-skills.js"
    },
    "./standard-preset": {
      "types": "./lib/types/runtime/standard-preset.d.ts",
      "default": "./lib/runtime/standard-preset.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "client",
    "schemas",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "business-resources",
    "src/inventory-compute",
    "src/aps-compute",
    "locale/"
  ],
  "scripts": {
    "typecheck": "node scripts/generate-plugin-package-version.mjs --check && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node scripts/generate-plugin-package-version.mjs && tsc -p tsconfig.json && pnpm run build:client",
    "build:client": "node scripts/generate-plugin-package-version.mjs && tsdown && node scripts/normalize-client-banner.mjs",
    "test": "pnpm run test:package-version && vitest run && pnpm run test:preset-client",
    "test:contract": "vitest run tests/routes.test.ts tests/agent-mcp.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "depcruise --validate .dependency-cruiser.cjs src",
    "check:refactor": "pnpm run check:static && pnpm run test:contract && pnpm run check:capabilities",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "check:knowledge": "node scripts/check-agent-knowledge.mjs",
    "test:knowledge": "node --test tests/agent-knowledge.test.mjs",
    "test:package-version": "node --test tests/plugin-package-version.test.mjs",
    "test:preset-client": "vitest run --config vitest.preset-client.config.ts",
    "test:preset-integration": "vitest run --config vitest.preset-integration.config.ts",
    "check:capabilities": "node scripts/check-preset-capabilities.mjs",
    "sdk:verify": "node scripts/prepare-official-sdk.mjs",
    "sdk:prepare": "node scripts/prepare-official-sdk.mjs --prepare",
    "quality:ci": "node scripts/run-quality-ci.mjs",
    "test:ci-inputs": "node --test tests/ci-applicability.test.mjs tests/plugin-package-version.test.mjs tests/sdk-input-cli.test.mjs tests/quality-ci-cli.test.mjs tests/run-quality-checks.test.mjs tests/preset-capabilities-cli.test.mjs tests/sdk-artifact-cache.test.mjs tests/download-cache.test.mjs",
    "check:static": "pnpm run check:knowledge && pnpm run test:knowledge && pnpm run test:ci-inputs && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run check:architecture",
    "test:ci-unit": "pnpm run test:package-version && vitest run --config vitest.ci-unit.config.ts",
    "test:agent-browser": "vitest run --config vitest.agent-browser.config.ts",
    "check:static:ci": "pnpm run check:knowledge && node scripts/generate-plugin-package-version.mjs --check && tsc -p tsconfig.client.json --noEmit && pnpm run lint && pnpm run format:check && pnpm run check:architecture"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.17.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CleverC2200/dsh-agent-manage.git"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "dsh-marketplace",
    "dsh-plugin-marketplace",
    "deepseek-plugin",
    "deepseek-plugins",
    "agent-plugins",
    "agent-plugin",
    "plugin-marketplace",
    "marketplace",
    "claude-code",
    "claude-code-plugins",
    "claude-code-plugin-marketplace",
    "claude",
    "codex",
    "cursor",
    "skills",
    "mcp",
    "mcp-servers",
    "hooks",
    "suite",
    "ai-agents"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.9 || 1.0.10-alpha.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-hooks-claude-code": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-hooks-claude-code": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "^8.17.1",
    "decimal.js": "10.6.0",
    "fflate": "^0.8.3",
    "js-yaml": "4.3.2",
    "smol-toml": "^1.8.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../official-latest-standard/vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "link:../../official-latest-standard/vendor/include",
    "@deepseek-ai/dsh-agent-preset-registry": "link:../../official-latest-standard/packages/preset/agent-preset-registry",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../official-latest-standard/packages/client/ui-primitives",
    "@deepseek-ai/dsh-hooks-claude-code": "link:../../official-latest-standard/packages/hooks/hooks-claude-code",
    "@deepseek-ai/dsh-llm": "link:../../official-latest-standard/packages/llm/llm",
    "@deepseek-ai/dsh-mcp-client": "link:../../official-latest-standard/packages/mcp/mcp-client",
    "@deepseek-ai/dsh-skill": "link:../../official-latest-standard/packages/skill/skill",
    "@deepseek-ai/dsh-skill-filesystem": "link:../../official-latest-standard/packages/skill/skill-filesystem",
    "@deepseek-ai/dsh-tools": "link:../../official-latest-standard/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../official-latest-standard/vendor/schemastery",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.58.2",
    "@tsdown/css": "^0.22.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "0.25.9",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/CleverC2200/dsh-agent-manage",
  "bugs": {
    "url": "https://github.com/CleverC2200/dsh-agent-manage/issues"
  }
}
